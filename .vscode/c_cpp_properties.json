{
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/**"
            ],
            "compilerPath": "/usr/bin/g++",
            "cStandard": "c17",
            "cppStandard": "c++20",
            "intelliSenseMode": "gcc-x64",
            "configurationProvider": "ms-vscode.cmake-tools"
        },
        {
            "name": "Win32",
            "includePath": [
                "${workspaceFolder}"
            ],
            "defines": [
                "IGROS_KERNEL",
                "IGROS_ARCH_x86_64",
                "IGROS_ARCH=x86_64",
                "IGROS_GIT_VERSION=\"0.0.0.0\"",
                "IGROS_GIT_VERSION_MAJOR=0",
                "IGROS_GIT_VERSION_MINOR=0",
                "IGROS_GIT_VERSION_PATCH=0",
                "IGROS_GIT_VERSION_BUILD=0",
                "IGROS_GIT_HASH=\"0\""
            ],
            "compilerPath": "C:/Program Files/LLVM/bin/clang++.exe",
            "compilerArgs": [
                "-ffreestanding",
                "-fno-exceptions"
            ],
            "cStandard": "c17",
            "cppStandard": "c++20",
            "intelliSenseMode": "windows-clang-x64"
        }
    ],
    "version": 4
}
