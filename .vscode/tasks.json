{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Clean i386",
			"type": "shell",
			"linux": {
				"command": "cmake",
				"args": [
					"--build",
					"--preset=\"build-linux-clang++-i386-debug\"",
					"--target=clean",
					"--parallel"
				]
			},
			"windows": {
				"command": ""
			},
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "Clean x86_64",
			"type": "shell",
			"linux": {
				"command": "cmake",
				"args": [
					"--build",
					"--preset=\"build-linux-clang++-x86_64-debug\"",
					"--target=clean",
					"--parallel"
				]
			},
			"windows": {
				"command": ""
			},
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "Clean all",
			"dependsOn": [
				"Clean i386",
				"Clean x86_64"
			],
			"dependsOrder": "parallel",
			"problemMatcher": []
		},
		{
			"label": "Configure i386 Release",
			"type": "shell",
			"linux": {
				"command": "cmake",
				"args": [
					"--preset=\"config-linux-clang++-i386-debug\""
				]
			},
			"windows": {
				"command": ""
			},
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "Configure x86_64 Release",
			"type": "shell",
			"linux": {
				"command": "cmake",
				"args": [
					"--preset=\"config-linux-clang++-x86_64-debug\""
				]
			},
			"windows": {
				"command": ""
			},
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "Build i386",
			"dependsOn": [
				"Configure i386 Release"
			],
			"type": "shell",
			"linux": {
				"command": "cmake",
				"args": [
					"--build",
					"--preset=\"build-linux-clang++-i386-debug\"",
					"--target=all",
					"--parallel"
				]
			},
			"windows": {
				"command": ""
			},
			"group": "build",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": ["$gcc"]
		},
		{
			"label": "Build x86_64",
			"dependsOn": [
				"Configure x86_64 Release"
			],
			"type": "shell",
			"linux": {
				"command": "cmake",
				"args": [
					"--build",
					"--preset=\"build-linux-clang++-x86_64-debug\"",
					"--target=all",
					"--parallel"
				]
			},
			"windows": {
				"command": ""
			},
			"group": "build",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": ["$gcc"]
		},
		{
			"label": "Build all",
			"dependsOn": [
				"Build i386",
				"Build x86_64"
			],
			"group": "build",
			"dependsOrder": "parallel",
			"problemMatcher": []
		},
		{
			"label": "Rebuild i386",
			"dependsOn": [
				"Distclean i386",
				"Clean i386",
				"Build i386"
			],
			"group": "build",
			"dependsOrder": "sequence",
			"problemMatcher": []
		},
		{
			"label": "Rebuild x86_64",
			"dependsOn": [
				"Distclean x86_64",
				"Clean x86_64",
				"Build x86_64"
			],
			"group": "build",
			"dependsOrder": "sequence",
			"problemMatcher": []
		},
		{
			"label": "Rebuild all",
			"dependsOn": [
				"Rebuild i386",
				"Rebuild x86_64"
			],
			"dependsOrder": "parallel",
			"problemMatcher": [],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "Install i386",
			"dependsOn": [
				"Rebuild i386"
			],
			"dependsOrder": "parallel",
			"type": "shell",
			"linux": {
				"command": "cmake",
				"args": [
					"--build",
					"--preset=\"build-linux-clang++-i386-debug\"",
					"--target=install",
					"--parallel"
				]
			},
			"windows": {
				"command": ""
			},
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "Install x86_64",
			"dependsOn": [
				"Rebuild x86_64"
			],
			"dependsOrder": "parallel",
			"type": "shell",
			"linux": {
				"command": "cmake",
				"args": [
					"--build",
					"--preset=\"build-linux-clang++-x86_64-debug\"",
					"--target=install",
					"--parallel"
				]
			},
			"windows": {
				"command": ""
			},
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "Install all",
			"dependsOn": [
				"Install i386",
				"Install x86_64"
			],
			"dependsOrder": "parallel",
			"problemMatcher": []
		},
		{
			"label": "Debug QEMU i386",
			"dependsOn": [
				"Install i386"
			],
			"type": "shell",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			},
			"isBackground": true,
			"problemMatcher": [
				{
					"pattern": [
						{
							"regexp": ".",
							"file": 1,
							"location": 2,
							"message": 3
						}
					],
					"background": {
						"activeOnStart": true,
						"beginsPattern": ".",
						"endsPattern": "."
					}
				}
			],
			"linux": {
				"command": "qemu-system-i386",
				"args": [
					"$IGROS_QEMU_OPTS",
					"-s",
					"-S",
					"./install/Debug/config-linux-clang++-i386-debug/kernel.iso"
				]
			}
		},
		{
			"label": "Debug QEMU x86_64",
			"dependsOn": [
				"Install x86_64"
			],
			"type": "shell",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			},
			"isBackground": true,
			"problemMatcher": [
				{
					"pattern": [
						{
							"regexp": ".",
							"file": 1,
							"location": 2,
							"message": 3
						}
					],
					"background": {
						"activeOnStart": true,
						"beginsPattern": ".",
						"endsPattern": "."
					}
				}
			],
			"linux": {
				"command": "qemu-system-x86_64",
				"args": [
					"$IGROS_QEMU_OPTS",
					"-s",
					"-S",
					"./install/Debug/config-linux-clang++-x86_64-debug/kernel.iso"
				]
			}
		},
		{
			"label": "Debug BOCHS i386",
			"dependsOn": [
				"Install i386"
			],
			"type": "shell",
			"problemMatcher": [],
			"linux": {
				"command": "bochs",
				"args": [
					"-f",
					"./config/test/bochs-i386"
				]
			}
		},
		{
			"label": "Debug BOCHS x86_64",
			"dependsOn": [
				"Install x86_64"
			],
			"type": "shell",
			"problemMatcher": [],
			"linux": {
				"command": "bochs",
				"args": [
					"-f",
					"./config/test/bochs-x86_64"
				]
			}
		}
	]
}

